# Copy to .env and run commands with:  uv run --env-file .env python manage.py runserver
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false:
# DJANGO_SECRET_KEY=generate-a-long-random-string
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to local SQLite. Use Postgres like this:
# DATABASE_URL=postgres://minishop:minishop@localhost:5432/minishop

# Leave empty to use the built-in mock payment page. For Stripe test mode:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
